{
  "name": "i-want-to-duck-meeting",
  "version": "0.3.0",
  "description": "Local meeting notes for Codex and Claude Code: Google Meet captions and audio, live transcripts, and offline microphone transcription.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "Arthur Wang",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "openmeeting": "bin/openmeeting.js"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 \"test/unit/**/*.test.js\"",
    "test:integration": "node --test --test-concurrency=1 \"test/integration/**/*.test.js\"",
    "test:all": "node --test --test-concurrency=1 \"test/unit/**/*.test.js\" \"test/integration/**/*.test.js\"",
    "setup": "node scripts/install.js",
    "install-codex": "node scripts/install.js --target codex",
    "install-plugin": "node scripts/install-plugin.js",
    "build:windows": "node scripts/build-windows.js"
  },
  "dependencies": {
    "playwright-core": "^1.63.0"
  },
  "keywords": [
    "agent-skills",
    "ai-agents",
    "claude-code",
    "claude-code-plugin",
    "codex-plugin",
    "codex-skill",
    "google-meet",
    "microsoft-teams",
    "meeting-notes",
    "speech-to-text",
    "paraformer",
    "whisper",
    "transcription",
    "developer-tools",
    "productivity"
  ]
}
