{
  "name": "openmeeting",
  "version": "0.1.0",
  "description": "Silent Google Meet notetaker bot driven from Claude Code: paste a link, it joins and records the transcript.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "Arthur Wang",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "openmeeting": "bin/openmeeting.js"
  },
