{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence-backed meeting minutes content; metadata and quality are rendered from local status/crosscheck",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "meetingId",
    "title",
    "participants",
    "summary",
    "topics",
    "decisions",
    "proposals",
    "risks",
    "openQuestions",
    "nextFollowUp",
    "actionItems"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "meetingId": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "role",
          "evidence"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence": {
            "$ref": "#/$defs/evidenceList"
          }
        }
      }
    },
    "summary": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "topics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "proposals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "openQuestions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "nextFollowUp": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "actionItems": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task",
          "owner",
          "deadline",
          "completionCriteria",
          "evidence"
        ],
        "properties": {
          "task": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": [
              "string",
              "null"
            ]
          },
          "deadline": {
            "type": [
              "string",
              "null"
            ]
          },
          "completionCriteria": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence": {
            "$ref": "#/$defs/evidenceList"
          }
        }
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "recordId",
        "quote"
      ],
      "properties": {
        "source": {
          "enum": [
            "captions",
            "recording"
          ]
        },
        "recordId": {
          "type": "integer",
          "minimum": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidenceList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "evidence"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "$ref": "#/$defs/evidenceList"
        }
      }
    }
  }
}
